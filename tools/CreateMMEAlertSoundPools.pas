unit UserScript;

var
  TargetFile, SkyrimFile, TemplateRecord, NewRecord: IInterface;
  CreatedCount, SoundCount: Integer;

function FindFileByName(aName: string): IInterface;
var i: Integer;
begin
  Result := nil;
  for i := 0 to FileCount - 1 do
    if SameText(GetFileName(FileByIndex(i)), aName) then begin
      Result := FileByIndex(i);
      Exit;
    end;
end;

procedure ClearSoundFiles(aRecord: IInterface);
var sounds: IInterface;
begin
  sounds := ElementByPath(aRecord, 'Sounds');
  if not Assigned(sounds) then Exit;
  while ElementCount(sounds) > 0 do
    Remove(ElementByIndex(sounds, 0));
end;

procedure AddSoundFile(aRecord: IInterface; aPath: string);
var sounds, e: IInterface;
begin
  sounds := ElementByPath(aRecord, 'Sounds');
  if not Assigned(sounds) then begin
    AddMessage('ERROR: Sounds array missing from ' + Name(aRecord));
    Exit;
  end;
  e := ElementAssign(sounds, HighInteger, nil, False);
  SetElementEditValues(e, 'ANAM - File Name', aPath);
  Inc(SoundCount);
end;

function MakePool(aEditorID, aExistingEditorID: string): IInterface;
begin
  Result := MainRecordByEditorID(GroupBySignature(TargetFile, 'SNDR'), aEditorID);
  if (not Assigned(Result)) and (aExistingEditorID <> '') then
    Result := MainRecordByEditorID(GroupBySignature(TargetFile, 'SNDR'), aExistingEditorID);
  if not Assigned(Result) then begin
    Result := wbCopyElementToFile(TemplateRecord, TargetFile, True, True);
    Inc(CreatedCount);
  end;
  SetEditorID(Result, aEditorID);
  ClearSoundFiles(Result);
end;

