<?xml version="1.0" encoding="UTF-8"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://qconsulting.ca/fo3/ModConfig5.0.xsd">
  <moduleName>MME Extensions</moduleName>

  <requiredInstallFiles>
    <folder source="Scripts" destination="Scripts" priority="0" />
    <folder source="Source" destination="Source" priority="0" />
    <folder source="SKSE" destination="SKSE" priority="0" />
    <folder source="Sound" destination="Sound" priority="0" />
    <folder source="meshes" destination="meshes" priority="0" />
    <folder source="Docs" destination="Docs" priority="0" />
    <folder source="SEQ" destination="SEQ" priority="0" />
    <file source="MMEAlert.esp" destination="MMEAlert.esp" priority="0" />
    <file source="MMEAlert_DISTR.ini" destination="MMEAlert_DISTR.ini" priority="0" />
    <file source="README.md" destination="README.md" priority="0" />
  </requiredInstallFiles>

  <installSteps order="Explicit">
    <installStep name="Installation Options">
      <optionalFileGroups order="Explicit">
        <group name="MAKE SURE MME EXTENSIONS LOADS AFTER THE ORIGINAL MILK MOD ECONOMY&#10;Choose a startup profile" type="SelectExactlyOne">
          <plugins order="Explicit">

            <plugin name="(Quick Start) Convenience MCM Defaults + Free milk on start">
              <description>Applies the Convenience MCM defaults once, then leaves your MME settings alone. Grants starter milk and armor, plus an open-bust heavy straitjacket when Devious Devices Expansion is installed.</description>
              <files>
                <file source="fomod\choices\recommended\Installer.json" destination="SKSE\Plugins\StorageUtilData\MMEAlerts\Installer.json" priority="0" />
                <file source="fomod\choices\recommended-quickstart\Scripts\MMEAlertsQuickTest.pex" destination="Scripts\MMEAlertsQuickTest.pex" priority="1" />
                <file source="fomod\choices\recommended-quickstart\Source\Scripts\MMEAlertsQuickTest.psc" destination="Source\Scripts\MMEAlertsQuickTest.psc" priority="1" />
              </files>
              <typeDescriptor>
                <type name="Recommended" />
              </typeDescriptor>
            </plugin>

            <plugin name="(Convenience) MCM Defaults + No milk on start">
              <description>Applies the Convenience MCM defaults once, then leaves your MME settings alone. Does not grant starter milk items.</description>
              <files>
                <file source="fomod\choices\recommended\Installer.json" destination="SKSE\Plugins\StorageUtilData\MMEAlerts\Installer.json" priority="0" />
              </files>
              <typeDescriptor>
                <type name="Optional" />
              </typeDescriptor>
            </plugin>

            <plugin name="(Vanilla) Do Not Change MME Settings + No milk on start">
              <description>Does not change MME settings and does not grant starter milk items.</description>
              <files>
                <file source="fomod\choices\standard\Installer.json" destination="SKSE\Plugins\StorageUtilData\MMEAlerts\Installer.json" priority="0" />
                <file source="fomod\choices\standard\Scripts\MMEAlertsFlatRateDefaults.pex" destination="Scripts\MMEAlertsFlatRateDefaults.pex" priority="1" />
                <file source="fomod\choices\standard\Source\Scripts\MMEAlertsFlatRateDefaults.psc" destination="Source\Scripts\MMEAlertsFlatRateDefaults.psc" priority="1" />
              </files>
              <typeDescriptor>
                <type name="Optional" />
              </typeDescriptor>
            </plugin>

          </plugins>
        </group>
        <group name="Optional mod compatibility" type="SelectAny">
          <plugins order="Explicit">

            <plugin name="All-in-One SexLab P+ Compatibility — READ INSTRUCTIONS CAREFULLY">
              <description>READ THE SEXLAB P+ INSTRUCTIONS CAREFULLY. Complete SexLab P+ support for MME Extensions and MME breastfeeding. Includes the approved MME script fixes, converted 3jiou breastfeeding animations, SLSB registry, and MME Extensions P+ backend. SexLab P+ itself is still required; the separate MME SLP+ Edit is not. IMPORTANT: rerun FNIS or your compatible behavior generator after installation.</description>
              <files>
                <folder source="fomod\choices\sexlab-pplus\meshes" destination="meshes" priority="30" />
                <folder source="fomod\choices\sexlab-pplus\SKSE" destination="SKSE" priority="30" />
                <file source="fomod\choices\sexlab-pplus\Scripts\MilkPlayerLoadGame.pex" destination="Scripts\MilkPlayerLoadGame.pex" priority="30" />
                <file source="fomod\choices\sexlab-pplus\Scripts\MME_Dialogues.pex" destination="Scripts\MME_Dialogues.pex" priority="30" />
                <file source="fomod\choices\sexlab-pplus\Scripts\MMESexLabBreastfeedingBackend.pex" destination="Scripts\MMESexLabBreastfeedingBackend.pex" priority="30" />
                <file source="fomod\choices\sexlab-pplus\Source\Scripts\MilkPlayerLoadGame.psc" destination="Source\Scripts\MilkPlayerLoadGame.psc" priority="30" />
                <file source="fomod\choices\sexlab-pplus\Source\Scripts\MME_Dialogues.psc" destination="Source\Scripts\MME_Dialogues.psc" priority="30" />
                <file source="fomod\choices\sexlab-pplus\Source\Scripts\MMESexLabBreastfeedingBackend.psc" destination="Source\Scripts\MMESexLabBreastfeedingBackend.psc" priority="30" />
                <file source="docs\SEXLAB-PPLUS-COMPATIBILITY.md" destination="Docs\MME Extensions - SexLab P+ Compatibility.md" priority="30" />
              </files>
              <typeDescriptor>
                <type name="Optional" />
              </typeDescriptor>
            </plugin>

            <plugin name="Install OMania compatibility">
              <description>Detects every implanted OMania pregnancy through OMania's authoritative API and uses MME Extensions' forced animated API to create Milk Maids. Automatically recommended when OMania.esp is active. The Troubleshoot page provides a manual Dragon Egg potion test.</description>
              <files>
                <file source="fomod\choices\omania-compatibility\OManiaCompatibility.json" destination="SKSE\Plugins\StorageUtilData\MMEAlerts\OManiaCompatibility.json" priority="10" />
              </files>
              <typeDescriptor>
                <dependencyType>
                  <defaultType name="Optional" />
                  <patterns>
                    <pattern>
                      <dependencies operator="And">
                        <fileDependency file="OMania.esp" state="Active" />
                      </dependencies>
                      <type name="Recommended" />
                    </pattern>
                  </patterns>
                </dependencyType>
              </typeDescriptor>
            </plugin>

            <plugin name="Elsie LaVache 3.4 — Recommended Compatibility Patch">
              <description>Elsie LaVache is a large erotic Milk Maid mod featuring new quests, characters, dialogue, and breastfeeding mechanics. This recommended patch fixes silent dialogue and broken script behavior, improves stability, and lets Elsie breastfeeding animations provide MME Extensions milk-drinking effects. Requires an active CP_Elsie.esp and is automatically selected when detected.</description>
              <files>
                <file source="fomod\choices\elsie-compatibility\ElsieCompatibility.json" destination="SKSE\Plugins\StorageUtilData\MMEAlerts\ElsieCompatibility.json" priority="20" />
                <file source="fomod\choices\elsie-compatibility\MME Extensions - Elsie LaVache Fix.esp" destination="MME Extensions - Elsie LaVache Fix.esp" priority="20" />
                <file source="fomod\choices\elsie-compatibility\Scripts\ELV_DiaGreets_PlayerAliasScript.pex" destination="Scripts\ELV_DiaGreets_PlayerAliasScript.pex" priority="20" />
                <file source="fomod\choices\elsie-compatibility\Scripts\ELVPlayerAliasscript.pex" destination="Scripts\ELVPlayerAliasscript.pex" priority="20" />
                <file source="fomod\choices\elsie-compatibility\Scripts\ELV_MMNPC_Scene_milk.pex" destination="Scripts\ELV_MMNPC_Scene_milk.pex" priority="20" />
                <file source="fomod\choices\elsie-compatibility\Scripts\ELV_MMNPC_Scene_milkingTime.pex" destination="Scripts\ELV_MMNPC_Scene_milkingTime.pex" priority="20" />
                <file source="fomod\choices\elsie-compatibility\Source\Scripts\ELV_DiaGreets_PlayerAliasScript.psc" destination="Source\Scripts\ELV_DiaGreets_PlayerAliasScript.psc" priority="20" />
                <file source="fomod\choices\elsie-compatibility\Source\Scripts\ELVPlayerAliasscript.psc" destination="Source\Scripts\ELVPlayerAliasscript.psc" priority="20" />
                <file source="fomod\choices\elsie-compatibility\Source\Scripts\ELV_MMNPC_Scene_milk.psc" destination="Source\Scripts\ELV_MMNPC_Scene_milk.psc" priority="20" />
                <file source="fomod\choices\elsie-compatibility\Source\Scripts\ELV_MMNPC_Scene_milkingTime.psc" destination="Source\Scripts\ELV_MMNPC_Scene_milkingTime.psc" priority="20" />
                <file source="docs\ELSIE-LAVACHE-FIX-CHANGELOG.md" destination="Docs\MME Extensions - Elsie LaVache Fix Changelog.md" priority="20" />
              </files>
              <typeDescriptor>
                <dependencyType>
                  <defaultType name="NotUsable" />
                  <patterns>
                    <pattern>
                      <dependencies operator="And">
                        <fileDependency file="CP_Elsie.esp" state="Active" />
                      </dependencies>
                      <type name="Required" />
                    </pattern>
                  </patterns>
                </dependencyType>
              </typeDescriptor>
            </plugin>

            <plugin name="JUGS — Stability and MME Compatibility Patch">
              <description>Recommended when JUGS is installed. Adds guarded SexLab scene startup, repairs participant and Soulgem Oven queue handling, and routes JUGS Milk Maid conversion through MME Extensions' supported API. Automatically selected when Jugs.esp is active.</description>
              <files>
                <folder source="fomod\choices\jugs-compatibility\Scripts" destination="Scripts" priority="20" />
                <folder source="fomod\choices\jugs-compatibility\Source\Scripts" destination="Source\Scripts" priority="20" />
                <file source="docs\JUGS-COMPATIBILITY-CHANGELOG.md" destination="Docs\MME Extensions - JUGS Compatibility Changelog.md" priority="20" />
              </files>
              <typeDescriptor>
                <dependencyType>
                  <defaultType name="NotUsable" />
                  <patterns>
                    <pattern>
                      <dependencies operator="And">
                        <fileDependency file="Jugs.esp" state="Active" />
                      </dependencies>
                      <type name="Required" />
                    </pattern>
                  </patterns>
                </dependencyType>
              </typeDescriptor>
            </plugin>

            <plugin name="Trap Treasure Chest with Tentacle Armor">
              <description>Requires C5Kev's Tentacled Terrors Of Tamriel 3BA and its active plugin, C5Kev's Tentacled Terrors Of Tamriel 3BA.esp. Download: https://www.nexusmods.com/skyrimspecialedition/mods/62644?tab=files. For treasure chests with a more... hands-on surprise. Tentacles included. Personal space not included.</description>
              <files>
                <file source="fomod\choices\timed-armor-c5kev\TimedArmor_C5Kev.json" destination="SKSE\Plugins\StorageUtilData\MMEAlerts\TimedArmor_C5Kev.json" priority="10" />
              </files>
              <typeDescriptor>
                <dependencyType>
                  <defaultType name="NotUsable" />
                  <patterns>
                    <pattern>
                      <dependencies operator="And">
                        <fileDependency file="C5Kev's Tentacled Terrors Of Tamriel 3BA.esp" state="Active" />
                      </dependencies>
                      <type name="Required" />
                    </pattern>
                  </patterns>
                </dependencyType>
              </typeDescriptor>
            </plugin>

            <plugin name="Trap Treasure Chest with Devious Dwemer Armor">
              <description>Requires Dwarven Devious Cuirass - 3BA SE/AE and its active base plugin, DwarvenDeviousCuirass.esp. Download: https://www.loverslab.com/files/file/23018-dwarven-devious-cuirass-3ba-seae/. The separate Devious Devices add-on ESP is not required. For treasure chests with an ancient Dwemer surprise. Questionable machinery included.</description>
              <files>
                <file source="fomod\choices\timed-armor-dwemer\TimedArmor_Dwemer.json" destination="SKSE\Plugins\StorageUtilData\MMEAlerts\TimedArmor_Dwemer.json" priority="10" />
              </files>
              <typeDescriptor>
                <dependencyType>
                  <defaultType name="NotUsable" />
                  <patterns>
                    <pattern>
                      <dependencies operator="And">
                        <fileDependency file="DwarvenDeviousCuirass.esp" state="Active" />
                      </dependencies>
                      <type name="Required" />
                    </pattern>
                  </patterns>
                </dependencyType>
              </typeDescriptor>
            </plugin>

          </plugins>
        </group>
      </optionalFileGroups>
    </installStep>
  </installSteps>
</config>
